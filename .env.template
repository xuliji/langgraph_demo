# 复制本文件为 .env 并填入真实值：cp .env.template .env
# 注意：.env 已被 .gitignore 忽略，请勿提交真实密钥

# DeepSeek API 基础地址
DEEPSEEK_API_BASE=https://api.deepseek.com

# DeepSeek API 密钥（替换为你自己的 key）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter API 密钥（chapter02/05-AgentLoop 使用 ChatOpenRouter）
# 获取地址：https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter API 基础地址（可选，不填使用官方默认 https://openrouter.ai/api/v1）
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
